+        BlockPos blockpos = getBlockPos(context, name);
+        if (!Level.isInSpawnableBounds(blockpos)) {
+            throw ERROR_OUT_OF_BOUNDS.create();
+        } else {
+            return blockpos;
+        }
+    }

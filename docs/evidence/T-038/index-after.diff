+            } else {
+                collection = ((SharedSuggestionProvider)context.getSource()).getRelevantCoordinates();
+            }
+
+            return SharedSuggestionProvider.suggestCoordinates(s, collection, builder, Commands.createValidator(this::parse));
+        }
